# GeoSentinel-AI — local environment
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored; never commit real credentials.

# --- Database (matches docker-compose.yml defaults) ---
POSTGRES_DB=geosentinel
POSTGRES_USER=geosentinel
POSTGRES_PASSWORD=geosentinel
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://geosentinel:geosentinel@localhost:5432/geosentinel

# --- OpenAI ---
OPENAI_API_KEY=

# --- Copernicus Data Space Ecosystem (https://eodata-sso.copernicus.eu) ---
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- App ---
ENVIRONMENT=development
# Comma-separated browser origins allowed to call the API.
# The defaults cover the usual local dev servers (Next.js, Vite).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
